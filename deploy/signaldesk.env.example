# Copy to /etc/signaldesk/signaldesk.env and chmod 600.
X_BEARER_TOKEN=replace_with_x_developer_bearer_token
HOST=127.0.0.1
PORT=4173
# Set this only when serving the API from a different origin.
CORS_ORIGIN=

# Optional post-search AI filtering. Provider must be openai or anthropic.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5.6-sol
# Anthropic example: LLM_PROVIDER=anthropic and LLM_MODEL=claude-fable-5
