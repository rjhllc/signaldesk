[Unit]
Description=SignalDesk live X intelligence
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=signaldesk
Group=signaldesk
WorkingDirectory=/opt/signaldesk
EnvironmentFile=/etc/signaldesk/signaldesk.env
ExecStart=/usr/bin/python3 /opt/signaldesk/backend.py
Restart=always
RestartSec=3
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
