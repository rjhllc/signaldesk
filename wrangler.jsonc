{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "signaldesk-app",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": [
    "python_workers"
  ],
  "workers_dev": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "ratelimits": [
    {
      "name": "PREVIEW_RATE_LIMITER",
      "namespace_id": "3370780047",
      "simple": {
        "limit": 240,
        "period": 60
      }
    },
    {
      "name": "PROVIDER_RATE_LIMITER",
      "namespace_id": "3379278507",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "app.signaldesk.run",
      "custom_domain": true
    }
  ]
}
